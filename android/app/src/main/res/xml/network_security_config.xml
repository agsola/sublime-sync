<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed at the platform level only because the Mac's
     Tailscale address isn't known at build time. SourceClient enforces that
     plain http is used only for Tailscale (100.64.0.0/10) addresses; the
     tunnel is WireGuard-encrypted and payloads are end-to-end encrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
